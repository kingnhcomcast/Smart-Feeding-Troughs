{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/kingnhcomcast/smartfeedingtroughs",
        "sources": "https://github.com/kingnhcomcast/smartfeedingtroughs"
    },
    "license": "${license}",
    "icon": "assets/smartfeedingtroughs/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.drahlek.smartfeedingtroughs.SmartFeedingTroughs"
        ],
        "client": [
            "io.drahlek.smartfeedingtroughs.SmartFeedingTroughsClient"
        ],
        "fabric-datagen": [
            "io.drahlek.smartfeedingtroughs.datagen.DataGenerator"
        ]
    },
    "mixins": [
        {
            "config": "smartfeedingtroughs.common.client.mixins.json",
            "environment": "client"
        },
        {
            "config": "smartfeedingtroughs.fabric.client.mixins.json",
            "environment": "client"
        },
        {
            "config": "smartfeedingtroughs.fabric.mixins.json"
        },
        {
            "config": "smartfeedingtroughs.common.main.mixins.json"
        }
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "dirigo": ">=${dirigo_min_version} <${dirigo_max_version}",
        "minecraft": ">=${minecraft_version_min} <${minecraft_version_max}",
        "java": ">=${java_version}"
    },
    "suggests": {
    }
}
  
