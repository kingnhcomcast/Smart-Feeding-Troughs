{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/kingnhcomcast/smartbreedingtroughs",
        "sources": "https://github.com/kingnhcomcast/smartbreedingtroughs"
    },
    "license": "${license}",
    "icon": "assets/smartbreedingtroughs/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "io.drahlek.smartbreedingtroughs.SmartBreedingTroughs"
        ],
        "client": [
            "io.drahlek.smartbreedingtroughs.SmartBreedingTroughsClient"
        ],
        "fabric-datagen": [
            "io.drahlek.smartbreedingtroughs.datagen.DataGenerator"
        ]
    },
    "mixins": [
        {
            "config": "smartbreedingtroughs.common.client.mixins.json",
            "environment": "client"
        },
        {
            "config": "smartbreedingtroughs.fabric.client.mixins.json",
            "environment": "client"
        },
        {
            "config": "smartbreedingtroughs.fabric.mixins.json"
        },
        {
            "config": "smartbreedingtroughs.common.main.mixins.json"
        }
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": ">=${minecraft_version_min} <${minecraft_version_max}",
        "java": ">=${java_version}"
    },
    "suggests": {
        "another-mod": "*"
    }
}
  
